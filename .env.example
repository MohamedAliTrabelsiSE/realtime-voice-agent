# ---- Server ----
PORT=3000
# Public WebSocket URL returned by POST /sessions (auto-derived from the Host header when unset)
# PUBLIC_WS_URL=wss://voice.example.com/voice/stream

# ---- OpenAI Realtime ----
# Leave empty to run in MOCK mode (no network calls, no cost).
OPENAI_API_KEY=
# Force mock mode even when a key is set: true | false
# MOCK_REALTIME=true
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
REALTIME_TRANSCRIPT_MODEL=gpt-4o-mini-transcribe
PCM_RATE=24000
# near_field (headset / phone) | far_field (laptop / speakerphone) | none
NOISE_REDUCTION=near_field
VAD_THRESHOLD=0.5
VAD_PREFIX_PADDING_MS=300
VAD_SILENCE_MS=500

# ---- WebSocket auth ----
# Required when NODE_ENV=production. Generate with: openssl rand -hex 32
VOICE_TOKEN_SECRET=
VOICE_TOKEN_TTL_SECONDS=600

# ---- Business (demo booking domain) ----
BUSINESS_NAME=Bright Smile Dental Clinic
BUSINESS_TIMEZONE=Europe/Paris
OPENING_HOUR=9
CLOSING_HOUR=17
SLOT_MINUTES=30
BOOKING_HORIZON_DAYS=14
